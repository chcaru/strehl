+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn float_sdr_capture_preserves_every_opaque_srgb_code() {
+        for code in 0u16..=255 {
+            let gamma = f32::from(code) / 255.0;
+            let linear = if gamma <= 0.04045 {
+                gamma / 12.92
+            } else {
+                ((gamma + 0.055) / 1.055).powf(2.4)
+            };
+            let pixel = screenshot_sdr([linear, linear, linear, 1.0], 1.0, false);
+            assert_eq!(pixel.to_array(), [code as u8, code as u8, code as u8, 255]);
+        }
+        assert_eq!(screenshot_sdr([1.0; 4], 1.0, false).r(), 255);
+        assert!(screenshot_sdr([1.0; 4], 1.0, true).r() < 255);
+    }
+}
