+// Ordinary egui textures remain SDR: decode sRGB once and match OS SDR white.
+// The photograph callback supplies its own unclipped scene-linear pixels.
+@fragment
+fn fs_main_extended_linear_framebuffer(in: VertexOutput) -> @location(0) vec4<f32> {
+    let gamma = in.color * sample_texture(in);
+    let alpha = gamma.a;
+    // egui also permits additive colors with zero alpha.
+    if alpha == 0.0 {
+        return vec4<f32>(linear_from_gamma_rgb(gamma.rgb) * r_locals.output_white_scale, 0.0);
+    }
+    let straight = gamma.rgb / max(alpha, 0.000001);
+    return vec4<f32>(linear_from_gamma_rgb(straight) * alpha * r_locals.output_white_scale, alpha);
+}
