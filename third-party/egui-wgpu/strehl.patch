+// Conversion at the OS presentation/readback boundary only. Image data and
+// arithmetic in Strehl remain f32; no half-float working image is created.
+fn half_to_float(bits: u16) -> f32 {
+    let sign = if bits & 0x8000 == 0 { 1.0 } else { -1.0 };
+    let exponent = (bits >> 10) & 31;
+    let mantissa = bits & 1023;
+    match exponent {
+        0 => sign * f32::from(mantissa) * 2.0f32.powi(-24),
+        31 => {
+            if mantissa == 0 {
+                sign * f32::INFINITY
+            } else {
+                f32::NAN
+            }
+        }
+        _ => sign * (1.0 + f32::from(mantissa) / 1024.0) * 2.0f32.powi(i32::from(exponent) - 15),
+    }
+}
+
+fn screenshot_sdr(rgba: [f32; 4], white: f32, hdr_active: bool) -> epaint::Color32 {
+    let rgb = [rgba[0], rgba[1], rgba[2]].map(|v| {
+        if v.is_finite() {
+            (v / white.max(0.1)).max(0.0)
+        } else {
+            0.0
+        }
+    });
+    let peak = rgb.iter().copied().fold(0.0, f32::max);
+    // SDR screenshot proxy: a smooth, hue-preserving shoulder makes above-white
+    // photo detail visible rather than interpreting float bytes as RGBA8.
+    let mapped = if !hdr_active || peak <= 0.75 {
+        peak
+    } else {
+        0.75 + 0.25 * (1.0 - (-(peak - 0.75) / 0.25).exp())
+    };
+    let gain = if peak > 0.0 { mapped / peak } else { 1.0 };
+    let encode = |x: f32| {
+        let x = x * gain;
+        let gamma = if x <= 0.0031308 {
+            x * 12.92
+        } else {
+            1.055 * x.powf(1.0 / 2.4) - 0.055
+        };
+        (gamma.clamp(0.0, 1.0) * 255.0 + 0.5) as u8
+    };
+    epaint::Color32::from_rgba_premultiplied(
+        encode(rgb[0]),
+        encode(rgb[1]),
+        encode(rgb[2]),
+        (rgba[3].clamp(0.0, 1.0) * 255.0 + 0.5) as u8,
+    )
+}
