        "anchors": [
          {
            "id": "fork-main-default-output-srgb",
            "lines": [
              "    std::string ocs = options.get_arg(\"--output-colorspace\", \"srgb\");",
              "    stack.set_output_colorspace(static_cast<int>(focusstack::parse_output_colorspace(ocs)));"
            ]
