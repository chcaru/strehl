    "blobs": [
      {
        "anchors": [
          {
            "id": "fork-input-modes-no-prophoto",
            "lines": [
              "InputColorSpace parse_input_colorspace(const std::string &name)",
              "{",
              "  if (name == \"\" || name == \"auto\")          return InputColorSpace::Auto;",
              "  if (name == \"none\" || name == \"raw\")       return InputColorSpace::None;",
              "  if (name == \"linear-rec2020\")              return InputColorSpace::LinearRec2020;",
              "  if (name == \"linear-srgb\" || name == \"linear-rec709\") return InputColorSpace::LinearSRGB;",
              "  if (name == \"srgb\")                        return InputColorSpace::SRGB;",
              "  // Unknown: fall back to auto to keep things robust.",
              "  return InputColorSpace::Auto;",
              "}"
            ]
          },
          {
            "id": "fork-integer-bypass",
            "lines": [
              "  // 8-bit and 16-bit pass through unchanged. They are assumed to already be",
              "  // in the output_cs primaries with the appropriate encoding (the pipeline",
              "  // does not mix encoded and float-source frames in a single stack).",
              "  if (depth == CV_8U || depth == CV_16U)",
              "  {",
              "    return raw;",
              "  }"
            ]
          }
        ],
        "bytes": 9977,
        "git_blob_sha1": "e89bb270f2c768df4765368b4c0d0f20ade8b551",
        "path": "focus-stack/src/colormgmt.cc",
        "sha256": "45c2b93c5c0c54c76a9c3398f376dd50682c2a30f3e3c8c75ca064ab6496db46"
      },
      {
        "anchors": [
          {
            "id": "fork-internal-srgb-oetf-contract",
            "lines": [
              "// The internal pipeline operates in 16-bit unsigned, sRGB-OETF-encoded data",
              "// (perceptual amplitude scale, which the wavelet fusion needs), but its",
              "// *primaries* are determined by `output_cs`:"
            ]
          },
          {
            "id": "fork-integer-assumed-output-space",
            "lines": [
              "// 8-bit and 16-bit inputs are assumed to already be in `output_cs` primaries",
              "// (the pipeline does not currently mix encoded and float inputs)."
            ]
          }
        ],
        "bytes": 5695,
        "git_blob_sha1": "8f1feeb5eed0169711b8d6a9d0100b5cfa8fe0cb",
        "path": "focus-stack/src/colormgmt.hh",
        "sha256": "fd88382402e03015af3c2d19bcb492d4874ae9288f9f2638be5e1886ce2c6fa9"
      },
      {
        "anchors": [
          {
            "id": "fork-imread-unchanged",
            "lines": [
              "  // IMREAD_UNCHANGED preserves bit depth and channel layout. Required to",
              "  // accept 16-bit and 32-bit float TIFFs without OpenCV silently casting to",
              "  // 8-bit (the IMREAD_ANYCOLOR default) or rejecting via the legacy",
              "  // TIFFRGBAImage path that cannot decode 32-bit float samples.",
              "  if (!m_result.data)",
              "  {",
              "    cv::Mat raw;",
              "    {",
              "      std::lock_guard<std::mutex> lock(g_imread_mutex);",
              "      raw = cv::imread(m_filename, cv::IMREAD_UNCHANGED);"
            ]
          }
        ],
        "bytes": 4099,
        "git_blob_sha1": "e5b511cdd21c4e50869fd5e7a8c0c25d7a3711e0",
        "path": "focus-stack/src/task_loadimg.cc",
