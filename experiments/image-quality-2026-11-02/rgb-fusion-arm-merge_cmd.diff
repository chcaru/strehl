+/// Crop the gathered missing colours onto the compact analysis domain, with the
+/// same non-negative clamp [`extract_planes`] applies to native samples.
+fn copy_extra_planes(
+    extra: &[Vec<f32>],
+    domain: PyramidDomain,
+    planes: &mut [Vec<f32>],
+) -> Result<()> {
+    ensure!(
+        extra.len() == planes.len(),
+        "{} gathered colours for {} RGB fusion planes",
+        extra.len(),
+        planes.len()
+    );
+    let local = domain.analysis();
+    let gw = domain.full.width;
+    planes.par_iter_mut().zip(extra.par_iter()).for_each(|(out, src)| {
+        out.par_chunks_mut(local.width).enumerate().for_each(|(ly, dst)| {
+            let row = (domain.rect.y + ly) * gw + domain.rect.x;
+            for (d, s) in dst.iter_mut().zip(&src[row..row + local.width]) {
+                *d = s.max(0.0);
+            }
+        });
+    });
+    Ok(())
+}
