+/// EXPERIMENT ONLY: `STREHL_LOCA_DELAY=dR,dB` (frames, fractional allowed).
+fn loca_delay() -> Option<[f32; 2]> {
+    static V: std::sync::OnceLock<Option<[f32; 2]>> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let raw = std::env::var("STREHL_LOCA_DELAY").ok()?;
+        let v: Vec<f32> = raw.split(',').map(|t| t.trim().parse().expect("STREHL_LOCA_DELAY")).collect();
+        assert!(v.len() == 2 && v.iter().all(|d| *d >= 0.0), "STREHL_LOCA_DELAY=dR,dB");
+        Some([v[0], v[1]])
+    })
+}
