@@ -2447,6 +2447,29 @@ impl BandMerge {
         let n0 = self.sizes[0].pixels();
         assert_eq!(luma.len(), n0);
         assert_eq!(variance.len(), n0);
+        // EXPERIMENT (LoCA delay): fold R and B from earlier frames, where they
+        // are sharp at the depth this frame's (green-led) weights select.
+        let loca_store;
+        let loca_refs: Vec<&[f32]>;
+        let planes: &[&[f32]] = match loca_delay().filter(|_| planes.len() == 4) {
+            None => planes,
+            Some(d) => {
+                let keep = d[0].max(d[1]).ceil() as usize + 1;
+                ws.loca_ring.push_front([planes[0].to_vec(), planes[3].to_vec()]);
+                ws.loca_ring.truncate(keep);
+                let at = |c: usize, delay: f32| -> Vec<f32> {
+                    let last = ws.loca_ring.len() - 1;
+                    let lo = (delay.floor() as usize).min(last);
+                    let hi = (delay.ceil() as usize).min(last);
+                    let t = if hi == lo { 0.0 } else { delay - delay.floor() };
+                    let (a, b) = (&ws.loca_ring[lo][c], &ws.loca_ring[hi][c]);
+                    a.iter().zip(b).map(|(x, y)| x + t * (y - x)).collect()
+                };
+                loca_store = [at(0, d[0]), at(1, d[1])];
+                loca_refs = vec![&loca_store[0], planes[1], planes[2], &loca_store[1]];
+                &loca_refs
+            }
+        };
 
