+/// EXPERIMENT ONLY: opacity-aware occlusion.
+/// `STREHL_OCCLUSION_OPACITY=zsig,margin,softness,levels,up,d0,d1,noise`.
+/// Frames fold near to far. Per coefficient at the `levels` finest bands, the
+/// first frame whose own energy reaches `zsig` noise units records its luma
+/// `up` levels coarser. A later frame (beyond `margin` folds, Gaussian ramp of
+/// `softness`) loses weight where its own coarse luma disagrees with that
+/// record (relative difference smoothstepped from `d0` to `d1`): a solid
+/// occluder changes the light there, a gap in a porous one does not.
+#[derive(Debug, Clone, Copy)]
+struct OcclusionOpacity {
+    zsig: f32,
+    margin: f32,
+    softness: f32,
+    levels: usize,
+    up: usize,
+    d0: f32,
+    d1: f32,
+    noise: f32,
+}
+
+fn occlusion_opacity() -> Option<OcclusionOpacity> {
+    static V: std::sync::OnceLock<Option<OcclusionOpacity>> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let raw = std::env::var("STREHL_OCCLUSION_OPACITY").ok()?;
+        let v: Vec<f32> = raw.split(',').map(|t| t.trim().parse().expect("STREHL_OCCLUSION_OPACITY")).collect();
+        assert_eq!(v.len(), 8, "STREHL_OCCLUSION_OPACITY=zsig,margin,softness,levels,up,d0,d1,noise");
+        Some(OcclusionOpacity { zsig: v[0], margin: v[1], softness: v[2], levels: v[3] as usize, up: v[4] as usize, d0: v[5], d1: v[6], noise: v[7] })
+    })
+}
+
 /// Environment override for the ensemble gate's default (`0`/`off` disables).
