+fn ca_override() -> Option<[f64; 6]> {
+    static V: std::sync::OnceLock<Option<[f64; 6]>> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let raw = std::env::var("STREHL_CA_OVERRIDE").ok()?;
+        let v: Vec<f64> = raw.split(',').map(|t| t.trim().parse().expect("STREHL_CA_OVERRIDE")).collect();
+        assert_eq!(v.len(), 6, "STREHL_CA_OVERRIDE=epsR,txR,tyR,epsB,txB,tyB");
+        Some([v[0], v[1], v[2], v[3], v[4], v[5]])
+    })
