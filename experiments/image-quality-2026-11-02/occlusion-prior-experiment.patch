+/// EXPERIMENT: a cheap first pass for the occlusion prior. Each frame's green
+/// luma is taken per quad, box-reduced to half the analysis plane, pulled onto
+/// the reference grid by its own placement, and scored with a log local
+/// high-pass energy normalised by signal (shot noise). Per cell, the near
+/// surface is the smallest frame index whose score is within `STREHL_OCCLUSION_ALPHA`
+/// (log2 units, default 1 = half the energy) of that cell's best.
+fn occlusion_prior(
+    source: &impl PyramidFrameSource,
+    n: usize,
+    domain: PyramidDomain,
+    levels: Levels,
+    warps: Option<&WarpMap>,
+) -> Result<strehl_core::pyramid::DepthPrior> {
+    let map = warps.context("the occlusion prior needs an alignment map")?;
+    let full = domain.full;
+    let (hw, hh) = (full.width / 2, full.height / 2);
+    let env = |k: &str, d: f32| std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d);
+    let alpha = env("STREHL_OCCLUSION_ALPHA", 1.0);
+    let scores: Vec<Option<Vec<u8>>> = (0..n)
+        .into_par_iter()
+        .map(|index| -> Result<Option<Vec<u8>>> {
+            let t = match map.warp(index)? {
+                FrameWarp::Placed(t) => *t,
+                FrameWarp::Refused(_) => return Ok(None),
+            };
+            let frame = source.decode(index)?;
+            let (ax, ay, stride) = (frame.active.x, frame.active.y, frame.stride);
+            let black = levels.black;
+            let g = |px: usize, py: usize| {
+                let r = (ay + 2 * py) * stride + ax + 2 * px;
+                0.5 * (f32::from(frame.data[r + 1]) + f32::from(frame.data[r + stride])) - black
+            };
+            // Half-plane source, box-reduced from the quad plane.
+            let mut src = vec![0.0f32; hw * hh];
+            for y in 0..hh {
+                for x in 0..hw {
+                    src[y * hw + x] = 0.25
+                        * (g(2 * x, 2 * y) + g(2 * x + 1, 2 * y) + g(2 * x, 2 * y + 1) + g(2 * x + 1, 2 * y + 1));
+                }
+            }
+            let (cx, cy) = (full.width as f64 * 0.5, full.height as f64 * 0.5);
+            let mut lum = vec![0.0f32; hw * hh];
+            for y in 0..hh {
+                for x in 0..hw {
+                    let (qx, qy) = t.apply_at(2.0 * x as f64 + 0.5, 2.0 * y as f64 + 0.5, cx, cy);
+                    let (sx, sy) = ((qx - 0.5) / 2.0, (qy - 0.5) / 2.0);
+                    let (x0, y0) = (sx.floor(), sy.floor());
+                    if x0 < 0.0 || y0 < 0.0 || x0 as usize + 1 >= hw || y0 as usize + 1 >= hh {
+                        continue;
+                    }
+                    let (fx, fy) = ((sx - x0) as f32, (sy - y0) as f32);
+                    let i = y0 as usize * hw + x0 as usize;
+                    lum[y * hw + x] = (1.0 - fy) * ((1.0 - fx) * src[i] + fx * src[i + 1])
+                        + fy * ((1.0 - fx) * src[i + hw] + fx * src[i + hw + 1]);
+                }
+            }
+            let box3 = |a: &[f32]| {
+                let mut o = vec![0.0f32; hw * hh];
+                for y in 1..hh - 1 {
+                    for x in 1..hw - 1 {
+                        let mut acc = 0.0;
+                        for dy in 0..3 {
+                            for dx in 0..3 {
+                                acc += a[(y + dy - 1) * hw + x + dx - 1];
+                            }
+                        }
+                        o[y * hw + x] = acc / 9.0;
+                    }
+                }
+                o
+            };
+            let mean = box3(&lum);
+            let sq: Vec<f32> = lum.iter().zip(&mean).map(|(l, m)| (l - m) * (l - m)).collect();
+            let energy = box3(&sq);
+            Ok(Some(
+                energy
+                    .iter()
+                    .zip(&mean)
+                    .map(|(e, m)| ((e / (m.max(0.0) + 64.0) + 1.0).log2() * 16.0).clamp(0.0, 255.0) as u8)
+                    .collect(),
+            ))
+        })
+        .collect::<Result<_>>()?;
+    let thr = (alpha * 16.0) as i32;
+    let mut near = vec![u16::MAX; hw * hh];
+    near.par_iter_mut().enumerate().for_each(|(j, d)| {
+        let best = scores.iter().flatten().map(|s| s[j]).max().unwrap_or(0) as i32;
+        if best < std::env::var("STREHL_OCCLUSION_FLOOR").ok().and_then(|v| v.parse().ok()).unwrap_or(24) {
+            return; // no surface above noise here: no prior
+        }
+        if let Some(i) = scores
+            .iter()
+            .position(|s| s.as_ref().is_some_and(|s| i32::from(s[j]) >= best - thr))
+        {
+            *d = i as u16;
+        }
+    });
+    // Keep a near-surface label only inside a coherent region of consistent
+    // depth (a leg, an antenna): where front and back alternate (hair), the
+    // local spread is large and the label is dropped, so legitimately visible
+    // farther detail between near strands is not suppressed.
+    let radius = env("STREHL_OCCLUSION_RADIUS", 6.0) as isize;
+    let max_iqr = env("STREHL_OCCLUSION_IQR", 10.0);
+    if radius > 0 {
+        let src = near.clone();
+        near.par_iter_mut().enumerate().for_each(|(j, d)| {
+            if *d == u16::MAX {
+                return;
+            }
+            let (x, y) = ((j % hw) as isize, (j / hw) as isize);
+            let mut v: Vec<u16> = Vec::with_capacity(((2 * radius + 1) * (2 * radius + 1)) as usize);
+            let mut total = 0usize;
+            for yy in (y - radius).max(0)..(y + radius + 1).min(hh as isize) {
+                for xx in (x - radius).max(0)..(x + radius + 1).min(hw as isize) {
+                    total += 1;
+                    let w = src[yy as usize * hw + xx as usize];
+                    if w != u16::MAX {
+                        v.push(w);
+                    }
+                }
+            }
+            if v.len() * 10 < total * 6 {
+                *d = u16::MAX;
+                return;
+            }
+            v.sort_unstable();
+            let iqr = f32::from(v[v.len() * 3 / 4]) - f32::from(v[v.len() / 4]);
+            if iqr > max_iqr {
+                *d = u16::MAX;
+            }
+        });
+    }
+    if let Ok(path) = std::env::var("STREHL_OCCLUSION_DUMP") {
+        let bytes: Vec<u8> = near.iter().flat_map(|v| v.to_le_bytes()).collect();
+        std::fs::write(&path, bytes)?;
+        eprintln!("occlusion map   : {path} ({hw}x{hh} u16, rect origin {},{})", domain.rect.x, domain.rect.y);
+    }
+    Ok(strehl_core::pyramid::DepthPrior {
+        near,
+        width: hw,
+        height: hh,
+        shift: 1,
+        offset: (domain.rect.x, domain.rect.y),
+        margin: env("STREHL_OCCLUSION_MARGIN", 20.0),
+        softness: env("STREHL_OCCLUSION_SOFTNESS", 15.0),
+        levels: env("STREHL_OCCLUSION_LEVELS", 3.0) as usize,
+    })
+}
