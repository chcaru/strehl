+/// EXPERIMENT: an occlusion prior. `near[y][x]` is the index of the nearest
+/// frame whose focus at that place is close to its best (u16::MAX: unknown), on
+/// a grid `2^shift` analysis-plane pixels per cell after adding `offset`.
+/// Frames more than `margin` beyond it lose weight at the finest `levels`
+/// bands with a Gaussian of width `softness` (frames): a nearer opaque
+/// surface cannot show a farther surface's fine detail.
+#[derive(Debug, Clone)]
+pub struct DepthPrior {
+    pub near: Vec<u16>,
+    pub width: usize,
+    pub height: usize,
+    pub shift: usize,
+    pub offset: (usize, usize),
+    pub margin: f32,
+    pub softness: f32,
+    pub levels: usize,
+}
+
+static DEPTH_PRIOR: std::sync::OnceLock<std::sync::Mutex<Option<std::sync::Arc<DepthPrior>>>> =
+    std::sync::OnceLock::new();
+
+/// Install (or clear) the process-wide experimental occlusion prior.
+pub fn set_depth_prior(prior: Option<DepthPrior>) {
+    *DEPTH_PRIOR.get_or_init(Default::default).lock().unwrap() = prior.map(std::sync::Arc::new);
+}
+
+fn depth_prior() -> Option<std::sync::Arc<DepthPrior>> {
+    DEPTH_PRIOR.get().and_then(|m| m.lock().unwrap().clone())
+}
