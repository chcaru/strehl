+/// Whether the band fold also fuses each source's reconstructed missing
+/// colours, so the writer can skip re-estimating them from the merged mosaic.
+pub fn rgb_fusion_enabled() -> bool {
+    static CHOICE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *CHOICE.get_or_init(|| {
+        match std::env::var(RGB_FUSION_ENV)
+            .unwrap_or_default()
+            .trim()
+            .to_ascii_lowercase()
+            .as_str()
+        {
+            "" | "0" | "off" | "false" | "no" => false,
+            "1" | "on" | "true" | "yes" => true,
+            other => panic!("{RGB_FUSION_ENV}={other:?} is neither on nor off"),
+        }
+    })
