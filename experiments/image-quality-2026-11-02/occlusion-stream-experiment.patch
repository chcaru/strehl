+/// EXPERIMENT ONLY: streaming occlusion. `STREHL_OCCLUSION_STREAM=zsig,margin,softness,levels`.
+/// Frames fold near to far; once a coefficient's own energy has been `zsig`
+/// times its noise energy in some frame, frames more than `margin` folds later
+/// lose weight with a Gaussian of width `softness` folds, at the `levels`
+/// finest bands: a nearer in-focus surface hides what is behind it.
+#[derive(Debug, Clone, Copy)]
+struct OcclusionStream {
+    zsig: f32,
+    margin: f32,
+    softness: f32,
+    levels: usize,
+}
+
+fn occlusion_stream() -> Option<OcclusionStream> {
+    static V: std::sync::OnceLock<Option<OcclusionStream>> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let raw = std::env::var("STREHL_OCCLUSION_STREAM").ok()?;
+        let v: Vec<f32> = raw.split(',').map(|t| t.trim().parse().expect("STREHL_OCCLUSION_STREAM")).collect();
+        assert_eq!(v.len(), 4, "STREHL_OCCLUSION_STREAM=zsig,margin,softness,levels");
+        Some(OcclusionStream { zsig: v[0], margin: v[1], softness: v[2], levels: v[3] as usize })
+    })
+}
+
