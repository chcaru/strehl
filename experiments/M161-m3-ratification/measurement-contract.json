      "manifest": "packages/fork/manifest.json"
    },
    {
      "product_id": "zerene-pmax",
      "role": "required_comparator",
      "manifest": "packages/zerene-pmax/manifest.json"
    },
    {
      "product_id": "zerene-dmap",
      "role": "required_comparator",
      "manifest": "packages/zerene-dmap/manifest.json"
    }
  ],
  "optional_products": [
    {
      "product_id": "helicon-a",
      "role": "optional_comparator",
      "manifest": "packages/helicon-a/manifest.json"
    },
    {
      "product_id": "helicon-b",
      "role": "optional_comparator",
      "manifest": "packages/helicon-b/manifest.json"
    },
    {
      "product_id": "helicon-c",
      "role": "optional_comparator",
      "manifest": "packages/helicon-c/manifest.json"
    }
  ],
  "profile_package_schema": "m161-m3-profile-package-v1",
  "measurement_output": "out/m3-score.json",
  "holdout_rule": "Commissioning and all checker changes must be frozen before any required product package is opened."
