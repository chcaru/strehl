+def _count_scaled(value, numerator_count, total_count):
+    """Fixed f32 count weighting, shared by the actual data/prior consumers."""
+    if (type(numerator_count) is not int or numerator_count <= 0
+            or type(total_count) is not int or total_count <= 0):
+        raise ValueError("positive original-observation counts required")
+    if not torch.is_tensor(value) or value.dtype != torch.float32 or value.ndim != 0:
+        raise ValueError("counted objective term must be scalar f32")
+    return value*(value.new_tensor(numerator_count)/value.new_tensor(total_count))
+
+
+def data_term(mu, codes, query, config, total_count):
+    """Sum original-sensel NLL/N; exposed producing path for partition tests."""
+    if not torch.is_tensor(codes) or codes.ndim != 1 or len(codes) != len(query.phase):
+        raise ValueError("one original code per supplied query required")
+    return _count_scaled(_nll(mu, codes, query, config), len(codes), total_count)
+
+
+def prior_term(x, config, total_count):
+    """Unchanged edge-loss SUM/N, counted once, including the fixed free apron."""
+    _, _, ow, oh = config.output_xywh
+    return _count_scaled(_prior(x, config), ow*oh, total_count)
+
