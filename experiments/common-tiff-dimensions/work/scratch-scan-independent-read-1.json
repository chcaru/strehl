  "saved_read_source": "from pathlib import Path\nimport json,hashlib,time,os,stat\nCPU=time.process_time();START=time.monotonic();READ=0\nROOT=Path.cwd();BASE=ROOT/'experiments/common-tiff-dimensions'\ndef read(rel,cap):\n global READ\n p=BASE/rel\n for q in (p,*p.parents):\n  s=q.lstat()\n  assert not stat.S_ISLNK(s.st_mode) and not getattr(s,'st_file_attributes',0)&0x400\n a=p.stat();assert stat.S_ISREG(a.st_mode) and 0<=a.st_size<=cap\n assert READ+a.st_size+1<=2*1024*1024\n with p.open('rb') as f:\n  b=os.fstat(f.fileno());raw=f.read(a.st_size+1);c=os.fstat(f.fileno())\n d=p.stat()\n ident=lambda x:(x.st_dev,x.st_ino,x.st_size,x.st_mtime_ns,x.st_nlink,getattr(x,'st_file_attributes',0))\n assert ident(a)==ident(b)==ident(c)==ident(d) and len(raw)==a.st_size\n READ+=len(raw);assert time.process_time()-CPU<9 and time.monotonic()-START<18\n return raw,{'path':str(p),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}\nnames={\n 'root':('work/scratch-control-root-1.json',65536),\n 'outer':('work/scratch-control-external-1/outer.json',65536),\n 'stdout':('work/scratch-control-external-1/stdout.bin',65536),\n 'stderr':('work/scratch-control-external-1/stderr.bin',16384),\n 'exit':('work/scratch-control-external-1/exit.txt',1024),\n 'result':('work/scratch-scan-controls-1/result.json',65536),\n 'progress':('work/scratch-scan-controls-1/progress.json',40960),\n 'scratch_keep':('work/scratch-scan-controls-1/scratch/keep.bin',11),\n 'scratch_victim':('work/scratch-scan-controls-1/scratch/victim.bin',11),\n 'retained_keep':('work/scratch-scan-controls-1/retained/keep.bin',11),\n 'retained_victim':('work/scratch-scan-controls-1/retained/victim.bin',11),\n 'controls':('scratch-scan-controls.py',32768),\n 'shim':('scratch-scan.py',16384),\n 'spec':('scratch-scan-spec.md',16384),\n 'wrapper':('scratch-control-capture.py',32768),\n 'held':('../m194h-pedestal-causality/build-and-run.py',65536)}\nbuffers={};refs={};values={}\nfor role,(name,cap) in names.items():\n raw,ref=read(name,cap);buffers[role]=raw;refs[role]=ref\n if role in ('root','outer','result','progress'):values[role]=json.loads(raw)\n elif role in ('stderr','exit'):values[role]=raw.decode('utf-8',errors='replace')\n elif role.startswith(('scratch_','retained_')):values[role]=raw.hex()\nassert buffers['stdout']==buffers['result']\nvalues['raw_stdout_equals_result']=True\nanswer={'refs':refs,'values':values,'read_bytes':READ,'cpu_sample':time.process_time()-CPU,\n 'wall_sample':time.monotonic()-START,'allocation':{'cpu_seconds':10,'active_wall_seconds':20,'read_bytes':2*1024*1024,'write_bytes':1024*1024}}\nprint(json.dumps(answer,sort_keys=True))\n",
